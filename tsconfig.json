{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "paths": {
      "hyperparam":["node_modules/hyperparam/lib/index.d.ts"],
      "~/*": ["src/*"],
      "@/*": ["src/vnve/editor/src/*"],
      "@vnve/core": ["src/vnve/core/src"]
    },
    "skipLibCheck": true
  },
  "include": [
    "tailwind.config.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/vnve/**/*"
  ]
}
